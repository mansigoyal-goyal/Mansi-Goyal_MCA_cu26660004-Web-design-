# Add this block to Apache's httpd-vhosts.conf.
# Change the directory paths to match your local installation.
<VirtualHost *:80>
    ServerName collegeweb.local
    DocumentRoot "C:/xampp/htdocs/collegeweb"
    <Directory "C:/xampp/htdocs/collegeweb">
        AllowOverride All
        Require all granted
    </Directory>
    ErrorLog "logs/collegeweb-error.log"
    CustomLog "logs/collegeweb-access.log" combined
</VirtualHost>

# Add this line to C:\Windows\System32\drivers\etc\hosts as Administrator:
# 127.0.0.1 collegeweb.local
